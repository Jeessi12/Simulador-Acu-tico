{
  "name": "simulador-acuatico",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:recursos && npm run build:simuladores && npm run build:simulator && npm run build:auth",
    "build:recursos": "vite build",
    "build:simuladores": "vite build --config vite.simuladores.config.ts",
    "build:auth": "vite build --config vite.auth.config.ts",
    "build:simulator": "vite build --config vite.simulator.config.ts",
    "dev:recursos": "vite",
    "test:load": "node ./node_modules/artillery/bin/run run load-tests/100-usuarios.yml",
    "test:load:report": "node ./node_modules/artillery/bin/run run --output reports/carga-100-usuarios.json load-tests/100-usuarios.yml"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.24.0",
    "motion": "^12.42.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "artillery": "^2.0.33",
    "autoprefixer": "^10.5.2",
    "postcss": "^8.5.18",
    "tailwindcss": "^3.4.17",
    "typescript": "^7.0.2",
    "vite": "^8.1.4"
  }
}
